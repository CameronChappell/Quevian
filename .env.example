# Optional AI provider. Configure real production values through Site settings.
QUEUEPILOT_OPENAI_KEY=
QUEUEPILOT_AI_MODEL=
QUEUEPILOT_AI_ORGANIZATIONS=

# Independent accounts (enable only after SMTP, email templates, and acceptance testing).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
QUEVIAN_SITE_URL=
QUEVIAN_EMAIL_AUTH_ENABLED=false
RESEND_API_KEY=
# Optional separate Full access key for receiving when the existing key is send-only.
RESEND_RECEIVING_API_KEY=
QUEVIAN_EMAIL_FROM=
# Optional dedicated sender for ticket replies; account email keeps its own sender.
QUEVIAN_SUPPORT_EMAIL_FROM=

QUEVIAN_INBOUND_DOMAIN=

RESEND_WEBHOOK_SECRET=

# Operator jobs. Generate a long random token and keep it in runtime secrets/Vault only.
QUEVIAN_OPERATOR_ID=
QUEVIAN_JOB_TOKEN=
QUEVIAN_JOBS_ENABLED=false

# Paid subscriptions: leave disabled until account, legal and provider acceptance are complete.
QUEVIAN_BILLING_ENABLED=false
QUEVIAN_BILLING_REQUIRED=false
QUEVIAN_LEGAL_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX=false
